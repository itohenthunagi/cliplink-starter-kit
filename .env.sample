# Cliplink の設定の見本。セットアップで、これをもとに .env（あなた専用の設定）が作られる。
# .env には合言葉（接続情報）が入るので、人に見せたり渡したりしない。

# アプリの表示名（管理画面・共有ページの上に出る）
CLIPLINK_APP_NAME=Cliplink

# 画像の保管先: r2（Cloudflare R2） / dropbox / gdrive（Googleドライブ）
CLIPLINK_STORAGE_PROVIDER=

# 共有URL https://<この名前>.pages.dev になる。英小文字・数字・ハイフン。本名や会社名は避ける
CLIPLINK_CLOUDFLARE_PROJECT=

# PCの中の画像の保存フォルダ（絶対パス）
# 例: Windows  C:\Users\<名前>\Pictures\Cliplink
#     macOS    /Users/<名前>/Pictures/Cliplink
CLIPLINK_STORAGE_ROOT=

# 設定と記録の置き場所。Dropbox・OneDrive等の同期フォルダの外にする。空欄なら .cliplink
CLIPLINK_STATE_DIR=

# 管理画面の番号（http://127.0.0.1:<PORT>）
PORT=4317

# ---- 以下はセットアップのコマンドが自動で書き込む。手で入力・表示・共有しない ----

# 共有モード（cloud）と共有ページのURL。npm run setup:cloudflare が書く
CLIPLINK_MODE=
CLIPLINK_GATEWAY_URL=
CLIPLINK_ADMIN_TOKEN=

# Dropbox を選んだ場合。npm run setup:dropbox が書く
DROPBOX_ROOT=/ScreenShare
DROPBOX_APP_KEY=
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_SECRET=

# Googleドライブを選んだ場合。npm run setup:google が書く
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ---- 上級者向け ----
# 自動起動したサーバーを、最後の操作から何ミリ秒で止めるか（0=止めない）
CLIPLINK_IDLE_TIMEOUT_MS=
